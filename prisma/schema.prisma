generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  RESEARCHER
  ADMIN
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  REMEDIATING
  PATCHED
  CLOSED
}

enum PatchReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String                @unique @db.VarChar(255)
  displayName         String                @map("display_name") @db.VarChar(120)
  passwordHash        String                @map("password_hash") @db.VarChar(255)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles               UserRole[]
  submittedReports    VulnerabilityReport[] @relation("ReportOwner")
  assignedReports     VulnerabilityReport[] @relation("ReportAssignee")
  statusChanges       ReportStatusHistory[]
  recordedPayouts     BountyPayout[]        @relation("PayoutRecorder")
  submittedPatches    Patch[] @relation("PatchSubmitter")
  reviewedPatches     Patch[] @relation("PatchReviewer")
  auditEvents         AuditLog[]

  @@map("users")
}

model Role {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      RoleName   @unique
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  members   UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model VulnerabilityReport {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title               String                @db.VarChar(200)
  description         String
  affectedAsset       String                @map("affected_asset") @db.VarChar(255)
  severity            Severity              @default(MEDIUM)
  status              ReportStatus          @default(SUBMITTED)
  reporterId          String                @map("reporter_id") @db.Uuid
  assignedAdminId     String?               @map("assigned_admin_id") @db.Uuid
  lastStatusChangedBy String?               @map("last_status_changed_by") @db.Uuid
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  reporter            User                  @relation("ReportOwner", fields: [reporterId], references: [id], onDelete: Restrict)
  assignedAdmin       User?                 @relation("ReportAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  statusHistory       ReportStatusHistory[]
  patches             Patch[]
  payout              BountyPayout?

  @@index([reporterId, status])
  @@index([status, severity, createdAt(sort: Desc)])
  @@map("vulnerability_reports")
}

model ReportStatusHistory {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId   String               @map("report_id") @db.Uuid
  fromStatus ReportStatus?        @map("from_status")
  toStatus   ReportStatus         @map("to_status")
  changedById String?             @map("changed_by_id") @db.Uuid
  note       String?              @db.VarChar(500)
  changedAt  DateTime             @default(now()) @map("changed_at") @db.Timestamptz(6)
  report     VulnerabilityReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  changedBy  User?                @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([reportId, changedAt(sort: Desc)])
  @@map("report_status_history")
}

model Patch {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId    String               @map("report_id") @db.Uuid
  summary     String
  reference   String               @db.VarChar(255)
  reviewStatus PatchReviewStatus @default(PENDING) @map("review_status")
  submittedById String? @map("submitted_by_id") @db.Uuid
  reviewedById String? @map("reviewed_by_id") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewNote String? @map("review_note") @db.VarChar(500)
  submittedBy User? @relation("PatchSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("PatchReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  patchedAt   DateTime             @map("patched_at") @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  report      VulnerabilityReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, reference])
  @@index([reportId, patchedAt(sort: Desc)])
  @@map("patches")
}

model BountyPayout {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId     String               @unique @map("report_id") @db.Uuid
  amount       Decimal              @db.Decimal(12, 2)
  currency     String               @default("INR") @db.Char(3)
  reference    String               @unique @db.VarChar(100)
  recordedById String               @map("recorded_by_id") @db.Uuid
  recordedAt   DateTime             @default(now()) @map("recorded_at") @db.Timestamptz(6)
  report       VulnerabilityReport  @relation(fields: [reportId], references: [id], onDelete: Restrict)
  recordedBy   User                 @relation("PayoutRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([recordedAt(sort: Desc)])
  @@map("bounty_payouts")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
