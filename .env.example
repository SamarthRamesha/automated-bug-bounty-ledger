# Native local PostgreSQL service. Do not commit a real password.
DATABASE_URL="postgresql://postgres:replace_with_local_password@localhost:5432/bug_bounty_ledger?schema=public"

# Native local MongoDB service. Do not commit credentials or a production URI.
MONGODB_URI="mongodb://127.0.0.1:27017/bug_bounty_ledger"
MONGODB_DB_NAME="bug_bounty_ledger"

# Generate with: openssl rand -base64 32
SESSION_SECRET="replace_with_a_long_random_local_secret"

# Browser-visible application origin for local development.
APP_URL="http://localhost:3000"
